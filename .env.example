# Production custom domain preferred; r2.dev is acceptable for testing.
R2_PUBLIC_BASE_URL=

# Safe defaults for a long-running resumable import.
IMPORT_START_PAGE=1
IMPORT_END_PAGE=40
IMPORT_CONCURRENCY=2
UPLOAD_CONCURRENCY=4
DRY_RUN=false

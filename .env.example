YUPOO_BASE_URL=https://k-kgvcch123.x.yupoo.com
YUPOO_PASSWORD=
SUPABASE_URL=
# Preferred for trusted server-side imports.
SUPABASE_SECRET_KEY=
# Temporary alternative used with the locked import-token RLS policies.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_IMPORT_TOKEN=
SUPABASE_STORAGE_BUCKET=product-images

# Use Cloudflare R2 for the full catalog image library.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
